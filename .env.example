# Copy to .env and fill in.

# The persistent Local API key returned by the enablement call.
# If you only have the enablement TOKEN (emailed from vestaboard.com/local-api),
# set VESTABOARD_ENABLEMENT_TOKEN below and run `npm run enable` once to obtain this key.
VESTABOARD_LOCAL_API_KEY=

# One-time enablement token from vestaboard.com/local-api (only needed for `npm run enable`).
VESTABOARD_ENABLEMENT_TOKEN=

# Board host. Default is the mDNS name; use the board's IPv4 address if mDNS is flaky.
# IPv6 is not reliably supported by the Local API — prefer IPv4.
VESTABOARD_HOST=vestaboard.local

# Admin website port.
PORT=3000

# GNews API key for the headline news app.
GNEWS_API_KEY=
